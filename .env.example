# Copy this file to ".env" and edit the values. ".env" is ignored by Git.
# This project needs no API keys. Only local paths live here.
DUCKDB_PATH=data/ebd.duckdb
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed

# First admission date to include. Synthea simulates whole lifetimes, so we cut to recent years.
WINDOW_START=2021-01-01
